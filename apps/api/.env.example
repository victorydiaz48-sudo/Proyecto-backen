# Copiar a .env (no se commitea). Valores de desarrollo local, nunca de producción.
# La app se conecta con el rol reservas_app (sujeto a Row-Level Security, ver docs/SECURITY.md).
DATABASE_URL="postgresql://reservas_app:reservas_app@localhost:5432/reservas_dev"
# Migraciones (prisma migrate) y seed: el propietario del esquema.
MIGRATION_DATABASE_URL="postgresql://reservas:reservas@localhost:5432/reservas_dev"
# Base de datos que los tests de integración vacían y migran en cada ejecución.
# Propietario (prepara datos y migra); la app bajo prueba usa reservas_app en esa misma BD
# (TEST_APP_DATABASE_URL, por defecto la misma URL con reservas_app:reservas_app).
TEST_DATABASE_URL="postgresql://reservas:reservas@localhost:5432/reservas_test"
SHADOW_DATABASE_URL="postgresql://reservas:reservas@localhost:5432/reservas_shadow"
# Servidor
HOST="0.0.0.0"
PORT=3000
LOG_LEVEL="info"
# Detrás de un proxy/balanceador: sus IPs/CIDR o "uniquelocal" (redes privadas). Nunca true.
TRUST_PROXY=false
# Cookie de sesión solo por HTTPS. En producción siempre true (no se puede desactivar).
# COOKIE_SECURE=false
# Avisos al negocio por Telegram (token de @BotFather). Opcional.
# TELEGRAM_BOT_TOKEN=
