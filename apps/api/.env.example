# Copiar a .env (no se commitea). Valores de desarrollo local, nunca de producción.
DATABASE_URL="postgresql://reservas:reservas@localhost:5432/reservas_dev"
# Base de datos que los tests de integración vacían y migran en cada ejecución.
TEST_DATABASE_URL="postgresql://reservas:reservas@localhost:5432/reservas_test"
SHADOW_DATABASE_URL="postgresql://reservas:reservas@localhost:5432/reservas_shadow"
# Servidor
HOST="0.0.0.0"
PORT=3000
LOG_LEVEL="info"
# true detrás de un proxy/balanceador que termina TLS
TRUST_PROXY=false
# Cookie de sesión solo por HTTPS. En producción siempre true (no se puede desactivar).
# COOKIE_SECURE=false
