# ---------------------------------------------------------------------------
# Environment variables. On Railway/Render you paste these into the service's
# "Variables" / "Environment" tab — you never need a .env file on a server.
# NEVER commit a real .env file (it is git-ignored).
#
# Blank values are treated as "not set".
# Variables marked (Phase N) are not used yet; they are listed so the full
# picture is visible from day one.
# ---------------------------------------------------------------------------

# ===== Core =================================================================

# true  = the whole flow runs on mock providers: no paid API is called.
# false = real providers are used (only those that are configured).
MOCK_MODE=true

# Delay (ms) added by mock providers so the demo feels like the real thing.
MOCK_LATENCY_MS=800

# Default bot language: es (Spanish), pt (Portuguese) or en (English).
# (Phase 2 makes this configurable per dealership.)
DEFAULT_LOCALE=es

# debug | info | warn | error
LOG_LEVEL=info

# HTTP port. Railway/Render set this automatically — leave it unset there.
# PORT=3000

# What this process runs: all (bot + worker, default), telegram, or worker.
SERVICE=all

# Jobs processed in parallel by the worker.
WORKER_CONCURRENCY=4

# ===== Telegram =============================================================

# Bot token from @BotFather (Telegram app → search "BotFather" → /newbot).
# Looks like 123456789:AAE...  REQUIRED for the bot to work.
TELEGRAM_BOT_TOKEN=

# polling = the bot fetches messages itself. No public URL needed. (default)
# webhook = Telegram pushes messages to TELEGRAM_WEBHOOK_URL. Needs a public
#           https domain (Railway: Settings → Networking → Generate Domain).
TELEGRAM_MODE=polling

# Only for webhook mode: your service's public base URL, e.g.
# https://your-app.up.railway.app   (the path /telegram/webhook is added for you)
TELEGRAM_WEBHOOK_URL=

# One-time code that makes the first person to open
# https://t.me/<bot>?start=<code> the OWNER of the demo dealership.
# 12-64 chars of A-Z a-z 0-9 _ -. Useless once claimed; you can delete it after.
BOOTSTRAP_CODE=

# Only for webhook mode: random string, 16-256 chars of A-Z a-z 0-9 _ -
# Telegram sends it back on every call so fake requests are rejected.
# Any password generator works; use 32+ characters.
TELEGRAM_WEBHOOK_SECRET=

# ===== Image upload limits ==================================================

# Max accepted photo size in bytes (default 10 MB).
MAX_IMAGE_BYTES=10485760
# Shortest side must be at least this many pixels.
MIN_IMAGE_DIMENSION=320
# Longest side may be at most this many pixels.
MAX_IMAGE_DIMENSION=10000

# ===== AI providers =========================================================

# (Phase 4) API key for the vision / copywriting model.
AI_API_KEY=

# (Phase 6) API key for the image generation provider.
IMAGE_GENERATION_API_KEY=

# (Phase 7) API key for the video generation provider.
VIDEO_GENERATION_API_KEY=

# ===== Infrastructure =======================================================

# REQUIRED. PostgreSQL 15+ connection string. On Railway: add a PostgreSQL
# service and add a *reference* to its DATABASE_URL (see SETUP.md step 3).
# Without it the bot only answers "not configured".
DATABASE_URL=

# Recommended. Redis for the job queue (BullMQ). On Railway: add a Redis
# service and reference its REDIS_URL. Without it jobs run in memory and are
# re-queued from the database after a restart.
REDIS_URL=

# (Used from the dashboard phase) Keys that encrypt API keys stored in the database, as
# "version:base64key" (32 random bytes). Several, comma separated, for
# rotation — the highest version encrypts new secrets. SETUP.md will explain
# how to generate one without a terminal.
ENCRYPTION_KEYS=

# Retries after the first attempt for failed jobs (default 3 → up to 4 tries,
# waiting 2s, 4s, 8s between them).
JOB_MAX_RETRIES=3

# S3-compatible storage for photos (Cloudflare R2, AWS S3, Backblaze B2…).
# Set all four or none. Without them photos go to the server's disk, which
# is wiped on redeploy (SETUP.md step 10).
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
# R2: auto (default). AWS: the bucket's region, e.g. eu-west-1.
STORAGE_REGION=auto
# true for MinIO and some self-hosted S3 services.
STORAGE_FORCE_PATH_STYLE=false
# Folder used when S3 is not configured.
STORAGE_LOCAL_DIR=/tmp/autocontent-storage

# ===== Publishing ===========================================================

# (Phase 10) Blotato API key — https://blotato.com → Settings → API.
# In production each dealership enters its own key in the dashboard; this
# variable is only a fallback for single-dealership setups.
BLOTATO_API_KEY=
