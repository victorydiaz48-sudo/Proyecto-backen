  "name": "Fast Sale",
  "description": "Direct, conversion-focused content to move inventory quickly.",
  "tone": {
    "voice": "direct, upbeat, action-oriented",
    "adjectives": [
      "available now",
      "ready to drive",
      "great opportunity"
    ],
    "avoid": [
      "fake scarcity",
      "prices or discounts not provided",
      "'last unit' claims"
    ]
  },
  "prompt": {
    "copyGuidance": "Get to the point fast: what it is, why it's worth a look, how to act now. Use the user-provided price and offer only if present.",
    "imageGuidance": "Bright, clean backgrounds; the car large in frame; room for a price overlay when a price was provided."
  },
