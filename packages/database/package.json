{
  "name": "@autocontent/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "sync-verticals": "tsx scripts/sync-vertical-schemas.ts",
    "generate": "pnpm run sync-verticals && prisma generate",
    "migrate:deploy": "pnpm run sync-verticals && prisma migrate deploy",
    "migrate:dev": "pnpm run sync-verticals && prisma migrate dev",
    "seed": "tsx src/seed-cli.ts",
    "typecheck": "pnpm run sync-verticals && prisma generate >/dev/null && tsc -p tsconfig.json",
    "postinstall": "pnpm run sync-verticals && prisma generate"
  },
  "dependencies": {
    "@autocontent/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "prisma": "7.10.0"
  }
}
